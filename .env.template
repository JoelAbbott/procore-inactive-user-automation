# Procore Governance System Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: Procore API Credentials
# ============================================================================
# Get these from your Procore App Management page
PROCORE_CLIENT_ID=your_client_id_here
PROCORE_CLIENT_SECRET=your_client_secret_here
PROCORE_COMPANY_ID=your_company_id_here

# ============================================================================
# REQUIRED: Procore API URLs
# ============================================================================
# For production, change these to production URLs
PROCORE_BASE_URL=https://sandbox.procore.com
PROCORE_TOKEN_URL=https://sandbox.procore.com/oauth/token

# ============================================================================
# API CONFIGURATION (Fixed the pagination and timeout issues)
# ============================================================================
# Maximum items per API request (FIXED: was 1000, now correct limit)
API_MAX_PAGE_SIZE=300

# Maximum number of retry attempts for failed API calls
API_MAX_RETRIES=5

# Timeout for API requests in seconds
API_TIMEOUT_SECONDS=30

# Base backoff time for retries in seconds
API_BACKOFF_BASE_SECONDS=1.0

# ============================================================================
# BUSINESS LOGIC CONFIGURATION
# ============================================================================
# Number of days after which a user is considered inactive
INACTIVE_THRESHOLD_DAYS=365

# Number of days after account creation before flagging never-logged-in users
NEVER_LOGGED_IN_THRESHOLD_DAYS=180

# Your company's email domain (used to identify external users)
COMPANY_EMAIL_DOMAIN=compassdatacenters.com

# ============================================================================
# USER EXCLUSIONS
# ============================================================================
# Comma-separated list of DMSA user IDs to exclude from deactivation
# These are typically service accounts or special users
DMSA_USER_IDS=151870,46,151761

# Comma-separated list of admin user IDs to exclude from processing
ADMIN_USER_IDS=151870,46,151761

# ============================================================================
# WEBHOOK CONFIGURATION (Optional)
# ============================================================================
# URL where Procore will send webhook notifications
# Only needed if you're using the webhook listener
WEBHOOK_DELIVERY_URL=

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Base paths for data storage (relative to project root)
WEBHOOK_STORAGE_PATH=./data/webhooks/
LOGS_BASE_PATH=./data/logs
OUTPUT_DIR=./data/intermediate
REPORTS_DIR=./data/reports
AUDIT_LOGS_BASE=./data/audit_logs
ERROR_LOGS_BASE=./data/error_logs
DEACTIVATION_LOGS_BASE=./data/deactivation_logs

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
# How long to keep cached API data (in hours)
CACHE_TTL_HOURS=24

# ============================================================================
# SAFETY FEATURES (IMPORTANT: Keep these settings for testing!)
# ============================================================================
# Enable webhook listener functionality
ENABLE_WEBHOOK_LISTENER=true

# Enable automatic user deactivation (KEEP FALSE UNTIL READY!)
ENABLE_AUTO_DEACTIVATION=false

# Run in dry-run mode (KEEP TRUE FOR TESTING!)
DRY_RUN_MODE=true

# ============================================================================
# QUARTERLY EMAIL AUTOMATION (Optional but Recommended)
# ============================================================================
# Enable automated quarterly email reports to management
ENABLE_EMAIL_REPORTS=false

# Email server settings (Office 365 example - adjust for your email provider)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Email authentication (use your actual email credentials)
SMTP_USERNAME=your-email@compassdatacenters.com
SMTP_PASSWORD=your-app-password-here

# Email recipients for quarterly reports (comma-separated)
# Include your boss, compliance team, HR, etc.
QUARTERLY_REPORT_EMAILS=boss@compassdatacenters.com,compliance@compassdatacenters.com,hr@compassdatacenters.com

# Email formatting and branding
EMAIL_FROM_NAME=Procore Governance System
EMAIL_SUBJECT_PREFIX=[QUARTERLY REPORT]

# Schedule settings
QUARTERLY_EMAIL_TIME=09:00
QUARTERLY_EMAIL_DAY=1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable console logging
ENABLE_CONSOLE_LOGGING=true

# Enable file logging
ENABLE_FILE_LOGGING=true

# ============================================================================
# EMAIL SETUP INSTRUCTIONS
# ============================================================================
# 1. Get an "App Password" from your Office 365 account:
#    - Go to Office 365 Security settings
#    - Create a new App Password
#    - Use that password (not your regular login password)
#
# 2. Test email settings:
#    python -c "from email_manager import EmailManager; EmailManager().test_connection()"
#
# 3. Enable quarterly emails:
#    Set ENABLE_EMAIL_REPORTS=true
#
# 4. Start the scheduler:
#    python quarterly_scheduler.py

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use App Passwords, not regular passwords for email
# 3. Regularly rotate API credentials and email passwords
# 4. Monitor email logs for delivery failures
# 5. Test email functionality before enabling automation